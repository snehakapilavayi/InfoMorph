# ==============================================================================
# INFOMORPH — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# "One Source. Infinite Forms."
#
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Populate the required keys below.
# 3. Never commit .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (REQUIRED for Multi-Modal AI Transformation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth (REQUIRED for Persistence & Audit Logs)
# Found in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Optional: Server-only administrative key (keep strictly confidential)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Optional Integrations
# ------------------------------------------------------------------------------
# YouTube Data API v3 (Optional for video publishing / metadata analytics)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API (Optional for secondary cross-model benchmark validation)
# OPENAI_API_KEY=your_openai_api_key_here
